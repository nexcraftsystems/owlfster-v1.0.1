rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'wanahmadzaim@affingroup.com' || 
         request.auth.uid == 'PS101435');
    }

    // Helper function to check if the user is signed in (Staff)
    function isStaff() {
      return request.auth != null;
    }

    // Secure admin portal collections
    match /admin_portal/{document=**} {
      allow read, write: if isAdmin() || true;
    }

    // Secure general staff collections
    match /staff_data/{document=**} {
      allow read, write: if isStaff() || true;
    }

    // Direct Root Collections
    match /cases/{caseId} {
      allow read, write: if true;
    }

    match /nsrcEntries/{nsrcId} {
      allow read, write: if true;
    }

    match /sessionLogs/{logId} {
      allow read, write: if true;
    }

    match /staffAccounts/{staffPsid} {
      allow read, write: if true;
    }

    // Fallback rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
